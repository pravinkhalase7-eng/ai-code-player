# =============================================================================
# UPLOAD THIS FILE TO JENKINS as a Secret file
# =============================================================================
# 1. Copy this file locally:
#      cp ai-code-player.env.example ai-code-player.env
# 2. Paste real keys into GEMINI_API_KEY and GOOGLE_TTS_API_KEY (do not commit).
# 3. Jenkins → Manage Jenkins → Credentials → Global → Add Credentials
#      Kind: Secret file
#      ID:   ai-code-player-env-file
#      File: ai-code-player.env   (the filled copy)
#      Scope: Global
# 4. Point the Pipeline job at git:
#      https://github.com/pravinkhalase7-eng/ai-code-player
#      Script Path: Jenkinsfile
# =============================================================================

# Postgres (must match DATABASE_URL user/password/db)
POSTGRES_USER=tutor
POSTGRES_PASSWORD=tutor
POSTGRES_DB=aicoder

# Gemini (required)
GEMINI_API_KEY=PASTE_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GOOGLE_GENAI_USE_VERTEXAI=false

# Google Cloud Text-to-Speech (required for Chirp voice)
TTS_PROVIDER=google
TTS_FALLBACK_PROVIDER=google
TTS_VOICE=en-US-Chirp3-HD-Aoede
TTS_SPEED=0.96
GOOGLE_TTS_API_KEY=PASTE_GOOGLE_TTS_API_KEY_HERE
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Images
IMAGE_PROVIDER=gemini

# Local URLs below are rewritten by Jenkins to Docker service names.
DATABASE_URL=postgresql+psycopg://tutor:tutor@localhost:5432/aicoder
REDIS_URL=redis://localhost:6379/0
CODE_RUNNER_URL=http://localhost:8090
KOKORO_URL=http://localhost:8880
STORAGE_PROVIDER=local
STORAGE_PATH=./storage

CODE_EXECUTION_TIMEOUT=5
CODE_EXECUTION_MEMORY_MB=256
CODE_EXECUTION_CPU_LIMIT=1
CODE_EXECUTION_OUTPUT_LIMIT=65536
CODE_EXECUTION_PIDS_LIMIT=32

# Browser CORS / public UI (Jenkins overwrites CORS from PUBLIC_APP_URL)
CORS_ORIGINS=http://localhost:3010
NODE_ENV=production
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:3010
USE_CELERY=true
