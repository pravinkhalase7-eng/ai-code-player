# Database
DATABASE_URL=postgresql+psycopg://tutor:tutor@localhost:5432/aicoder

# Redis / jobs
REDIS_URL=redis://localhost:6379/0

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GOOGLE_GENAI_USE_VERTEXAI=false

# TTS
TTS_PROVIDER=google
TTS_FALLBACK_PROVIDER=google
TTS_VOICE=en-US-Chirp3-HD-Aoede
TTS_SPEED=0.96
GOOGLE_TTS_API_KEY=
KOKORO_URL=http://localhost:8880
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Images
IMAGE_PROVIDER=gemini

# Remotion
REMOTION_RENDERER_URL=http://localhost:3000

# Storage
STORAGE_PROVIDER=local
STORAGE_PATH=./storage

# Code execution
CODE_RUNNER_URL=http://localhost:8090
CODE_EXECUTION_TIMEOUT=5
CODE_EXECUTION_MEMORY_MB=256
CODE_EXECUTION_CPU_LIMIT=1
CODE_EXECUTION_OUTPUT_LIMIT=65536
CODE_EXECUTION_PIDS_LIMIT=32

# API
CORS_ORIGINS=http://localhost:3000
NODE_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3000
USE_CELERY=false

